  "units": [
    {
      "source_unit_id": "xhs:68456d2f0000000023013fe8:snapshot-95b77bb26104:note-desc-15:u1",
      "position": 1,
      "source_unit_type": "outcome-reflection-summary",
      "text_projection": "博主最近一个月面了20多场，拿到了一些offer，pkg涨幅35%-40%，在面试环节有一些自己的理解和心得，故而分享出来，如果有些表达不当的地方，欢迎大家指正。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/68456d2f0000000023013fe8.txt@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "0e9c92c65e5667a27c50eafa3f2869592924e80b9fba480f643e6a86e09b4697",
        "raw_artifact_ref": "liqiangcc/xhs:note_detail/68456d2f0000000023013fe8.html@95b77bb261048059846273688e4b90a2e108b437",
        "raw_sha256": "a25a22b9cd9ae7aedf3db7d1e4e34d0d7ab690032193eeaff4165660040aa246",
        "source_projection_item_number": 1
      },
      "fragments": []
    },
    {
      "source_unit_id": "xhs:68456d2f0000000023013fe8:snapshot-95b77bb26104:note-desc-15:u2",
      "position": 2,
      "source_unit_type": "question-like",
      "text_projection": "为什么要重视自我介绍：\n在后端社招面试中，自我介绍几乎是每一面都会出现的开场环节，虽然看起来是走个形式，实际上是你掌控面试节奏的最好时机。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/68456d2f0000000023013fe8.txt@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "0e9c92c65e5667a27c50eafa3f2869592924e80b9fba480f643e6a86e09b4697",
        "raw_artifact_ref": "liqiangcc/xhs:note_detail/68456d2f0000000023013fe8.html@95b77bb261048059846273688e4b90a2e108b437",
        "raw_sha256": "a25a22b9cd9ae7aedf3db7d1e4e34d0d7ab690032193eeaff4165660040aa246",
        "source_projection_item_number": 2
      },
      "fragments": []
    },
    {
      "source_unit_id": "xhs:68456d2f0000000023013fe8:snapshot-95b77bb26104:note-desc-15:u3",
      "position": 3,
      "source_unit_type": "question-like",
      "text_projection": "尤其对于社招来说，面试官更关注你的项目经历、在团队中的定位与技术深度。一个清晰、有重点的自我介绍，不仅能降低面试官的理解成本，还能引导对方问你擅长的内容，为接下来的技术深聊做好铺垫。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/68456d2f0000000023013fe8.txt@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "0e9c92c65e5667a27c50eafa3f2869592924e80b9fba480f643e6a86e09b4697",
        "raw_artifact_ref": "liqiangcc/xhs:note_detail/68456d2f0000000023013fe8.html@95b77bb261048059846273688e4b90a2e108b437",
        "raw_sha256": "a25a22b9cd9ae7aedf3db7d1e4e34d0d7ab690032193eeaff4165660040aa246",
        "source_projection_item_number": 3
      },
      "fragments": []
    },
    {
      "source_unit_id": "xhs:68456d2f0000000023013fe8:snapshot-95b77bb26104:note-desc-15:u4",
      "position": 4,
      "source_unit_type": "narrative-summary",
      "text_projection": "不该做什么：\n很多人习惯背简历，从第一段实习经历balabala讲到现在。这种方式不仅冗长，面试官也容易走神，他们手里本来就有你的简历，你要做的是给对方划重点，让对方快速捕捉到你的核心价值。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/68456d2f0000000023013fe8.txt@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "0e9c92c65e5667a27c50eafa3f2869592924e80b9fba480f643e6a86e09b4697",
        "raw_artifact_ref": "liqiangcc/xhs:note_detail/68456d2f0000000023013fe8.html@95b77bb261048059846273688e4b90a2e108b437",
        "raw_sha256": "a25a22b9cd9ae7aedf3db7d1e4e34d0d7ab690032193eeaff4165660040aa246",
        "source_projection_item_number": 4
      },
      "fragments": []
    },
    {
      "source_unit_id": "xhs:68456d2f0000000023013fe8:snapshot-95b77bb26104:note-desc-15:u5",
      "position": 5,
      "source_unit_type": "narrative-summary",
      "text_projection": "建议怎么说：",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/68456d2f0000000023013fe8.txt@95b77bb261048059846273688e4b90a2e108b437",
