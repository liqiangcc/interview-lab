        "source_projection_item_number": 8
      },
      "fragments": []
    },
    {
      "source_unit_id": "xhs:68456d2f0000000023013fe8:snapshot-95b77bb26104:note-desc-15:u9",
      "position": 9,
      "source_unit_type": "outcome-reflection-summary",
      "text_projection": "-最近一份工作/实习所在公司、入职时间。\n-所在部门/小组、职责分工。\n-你的角色定位（比如主程、Owner、负责核心模块等）。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/68456d2f0000000023013fe8.txt@95b77bb261048059846273688e4b90a2e108b437",
