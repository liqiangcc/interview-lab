    {
      "source_unit_id": "xhs:68747dcf000000002201ca0c:snapshot-95b77bb26104:note-desc-3:u2",
      "position": 2,
      "source_unit_type": "outcome-reflection-summary",
      "text_projection": "二面侧重框架和业务，Spring 的 AOP 原理，MyBatis 的 #{} 防注入细节。重点聊了订单系统设计，问如何处理高并发下的支付超时，我答用 Redis 过期回调 + 消息队列，面试官追问如果 Redis 挂了怎么办，补了数据库定时任务兜底。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/68747dcf000000002201ca0c.txt@95b77bb261048059846273688e4b90a2e108b437",
