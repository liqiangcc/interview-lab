      "fragments": []
    },
    {
      "source_unit_id": "xhs:68e7806c0000000005030b35:snapshot-95b77bb26104:note-json-desc-4:u2",
      "position": 2,
      "source_unit_type": "narrative-summary",
      "text_projection": "二面主攻高并发设计，给了拜年祭弹幕突增场景：如何设计限流降级。我答了网关 + 服务端两级限流，面试官立刻追问 Redis 队列的消费速度控制，以及延迟展示时如何保证高赞弹幕优先，不得不补充优先级队列和轮询策略才过关。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_json/68e7806c0000000005030b35.json@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "f71f7319d4d4c9c52902c322c654448534bdcee21e4159ddc08b7143f2ade85d",
        "raw_artifact_ref": "liqiangcc/xhs:note_detail/68e7806c0000000005030b35.html@95b77bb261048059846273688e4b90a2e108b437",
        "raw_sha256": "db7805e60a31d55223ef89b4251df1f96c6bbf36ef4ff031e9e4bfeb06d57f78",
        "source_projection_item_number": 2
      },
      "fragments": []
    },
    {
      "source_unit_id": "xhs:68e7806c0000000005030b35:snapshot-95b77bb26104:note-json-desc-4:u3",
      "position": 3,
      "source_unit_type": "outcome-reflection-summary",
      "text_projection": "三面直接上实际业务题：优化首页推荐接口性能。从多级缓存设计到异步并行加载，每步都被追问细节：缓存失效时如何避免雪崩？用户画像数据怎么实时同步？最后聊到弹幕实时计数，还被要求解释 Redis 分布式计数器的实现原理。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_json/68e7806c0000000005030b35.json@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "f71f7319d4d4c9c52902c322c654448534bdcee21e4159ddc08b7143f2ade85d",
