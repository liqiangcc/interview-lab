  "units": [
    {
      "source_unit_id": "xhs:67653219000000000800e928:snapshot-95b77bb26104:note-desc-7:u1",
      "position": 1,
      "source_unit_type": "narrative-summary",
      "text_projection": "1  Linux 系统管理\n问：请解释一下什么是inode，并说明它的作用。\n答：Inode是Linux文件系统的内部表示，每个文件或目录都有一个对应的inode。它存储了文件的元数据（如权限、所有者、时间戳等），但不包含文件名或其内容。当遇到无法写入文件的问题时，可以检查磁盘空间是否已满（使用`df h`）、文件系统是否有只读挂载（使用`mount`命令查看）或者该文件的inode是否已经被删除但仍被进程占用（使用`lsof`命令查找）。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/67653219000000000800e928.txt@95b77bb261048059846273688e4b90a2e108b437",
