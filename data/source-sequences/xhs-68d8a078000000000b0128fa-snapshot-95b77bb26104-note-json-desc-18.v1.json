      "source_unit_type": "question-like",
      "text_projection": "1. 业务与系统设计",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_json/68d8a078000000000b0128fa.json@95b77bb261048059846273688e4b90a2e108b437",
