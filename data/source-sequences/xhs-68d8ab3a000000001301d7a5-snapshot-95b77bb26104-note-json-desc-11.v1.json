      "fragments": []
    },
    {
      "source_unit_id": "xhs:68d8ab3a000000001301d7a5:snapshot-95b77bb26104:note-json-desc-11:u6",
      "position": 6,
      "source_unit_type": "question-like",
      "text_projection": "6.你觉得就是作为一个后端的工程师来讲，你觉得最重要的一些基本素质是什么？",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_json/68d8ab3a000000001301d7a5.json@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "d66f0df9d9d4f8097a99959bab59cdccb967ed9db2b9a650595f091167be4919",
        "raw_artifact_ref": "liqiangcc/xhs:note_detail/68d8ab3a000000001301d7a5.html@95b77bb261048059846273688e4b90a2e108b437",
        "raw_sha256": "cd257e85379e650861e1247ef79f9d9fb000f717520acc6b7b11607f99e0c87b",
        "source_projection_item_number": 6
