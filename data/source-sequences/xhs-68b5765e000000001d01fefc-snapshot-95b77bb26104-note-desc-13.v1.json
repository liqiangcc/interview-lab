      "position": 4,
      "source_unit_type": "narrative-summary",
      "text_projection": "③ 算法题\n* 实现快排\n👉 倾向点：基础算法能力 + Go 语言实现能力 + 时间复杂度分析",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/68b5765e000000001d01fefc.txt@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "e3220622fc8acb239dcb6b5db96338c4a2b47b209f4bbf87808df37407a982a6",
