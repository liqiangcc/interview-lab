        "raw_artifact_ref": "liqiangcc/xhs:note_detail/68dfd5470000000003020b68.html@95b77bb261048059846273688e4b90a2e108b437",
        "raw_sha256": "ba6cfc70ce9ff9e6e4bedb418a89c77480c8210b94390f5a133f10d6feb5682c",
