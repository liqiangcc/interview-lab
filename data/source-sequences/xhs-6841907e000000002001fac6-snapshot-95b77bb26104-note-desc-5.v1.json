  "units": [
    {
      "source_unit_id": "xhs:6841907e000000002001fac6:snapshot-95b77bb26104:note-desc-5:u1",
      "position": 1,
      "source_unit_type": "outcome-reflection-summary",
      "text_projection": "最近我在网上看到一个“AI面试工具”竟然在公开售卖，更离谱的是，它居然还能通过某家位于上海企业的CP备案，这不禁让人疑惑：这种明显带有欺诈性质的工具，难道真的没人监管吗？大家好，我是齐JavaKing，今天想和大家聊一个话题——关于“AI面试”。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/6841907e000000002001fac6.txt@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "7a94c61b1cf30f79452bf0d3cda2bac2f631438e876f49b267638e904f0d83bf",
        "raw_artifact_ref": "liqiangcc/xhs:note_detail/6841907e000000002001fac6.html@95b77bb261048059846273688e4b90a2e108b437",
        "raw_sha256": "0b60acaba29738d9e7e39c45fb82f6619255a8e2a7ff247482cfbcfe14497cd6",
        "source_projection_item_number": 1
      },
      "fragments": []
    },
    {
      "source_unit_id": "xhs:6841907e000000002001fac6:snapshot-95b77bb26104:note-desc-5:u2",
      "position": 2,
      "source_unit_type": "outcome-reflection-summary",
      "text_projection": "之前我也提到过类似的现象，当时就觉得挺不可思议了。但最近有个朋友告诉我，他用这个AI工具参加了一场线上面试，结果还真拿到了offer！要知道，他以前自己也做过面试官。现在他说以后招人坚决只做线下面试，因为他已经完全不相信线上面试的结果了。有人可能会说他是“得了便宜还卖乖”，不过我倒是好奇，到底是真有人看不惯他，还是有些人只是后悔自己没赶上用这工具呢😅？",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/6841907e000000002001fac6.txt@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "7a94c61b1cf30f79452bf0d3cda2bac2f631438e876f49b267638e904f0d83bf",
        "raw_artifact_ref": "liqiangcc/xhs:note_detail/6841907e000000002001fac6.html@95b77bb261048059846273688e4b90a2e108b437",
        "raw_sha256": "0b60acaba29738d9e7e39c45fb82f6619255a8e2a7ff247482cfbcfe14497cd6",
        "source_projection_item_number": 2
      },
      "fragments": []
    },
    {
      "source_unit_id": "xhs:6841907e000000002001fac6:snapshot-95b77bb26104:note-desc-5:u3",
      "position": 3,
      "source_unit_type": "narrative-summary",
      "text_projection": "还有些人觉得，用AI作弊一时半会儿看不出来。但我特意去看了这个工具的宣传页面，里面的文案真是“天花乱坠”。说什么可以实时提取面试官语音中的关键词，再调用最先进的AI模型快速生成答案，整个过程“安全隐蔽、不留痕迹”，面试官根本察觉不到🤖。甚至还有所谓的“简历查重功能”，用来检测你的项目是不是抄袭别人的，这样一来，哪怕培训机构统一包装的项目也能轻松过关。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/6841907e000000002001fac6.txt@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "7a94c61b1cf30f79452bf0d3cda2bac2f631438e876f49b267638e904f0d83bf",
        "raw_artifact_ref": "liqiangcc/xhs:note_detail/6841907e000000002001fac6.html@95b77bb261048059846273688e4b90a2e108b437",
        "raw_sha256": "0b60acaba29738d9e7e39c45fb82f6619255a8e2a7ff247482cfbcfe14497cd6",
        "source_projection_item_number": 3
      },
      "fragments": []
    },
    {
      "source_unit_id": "xhs:6841907e000000002001fac6:snapshot-95b77bb26104:note-desc-5:u4",
      "position": 4,
      "source_unit_type": "narrative-summary",
      "text_projection": "对于那些需要跨城市找工作的同学来说，这种趋势非常不友好。我以前经常建议候选人多尝试中小公司练手，前提就是线上面试成本低。如果每一场面试都必须线下进行，那机会只会越来越少。从长远来看，这类行为无疑增加了招聘双方的信任成本，因为少数人破坏了规则，导致所有人都要被迫接受更高成本的新规则😢。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/6841907e000000002001fac6.txt@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "7a94c61b1cf30f79452bf0d3cda2bac2f631438e876f49b267638e904f0d83bf",
        "raw_artifact_ref": "liqiangcc/xhs:note_detail/6841907e000000002001fac6.html@95b77bb261048059846273688e4b90a2e108b437",
        "raw_sha256": "0b60acaba29738d9e7e39c45fb82f6619255a8e2a7ff247482cfbcfe14497cd6",
        "source_projection_item_number": 4
      },
      "fragments": []
    },
    {
      "source_unit_id": "xhs:6841907e000000002001fac6:snapshot-95b77bb26104:note-desc-5:u5",
      "position": 5,
      "source_unit_type": "outcome-reflection-summary",
      "text_projection": "这让我想起验证码为什么越来越复杂，用户体验也越来越差，归根结底就是为了区分“真人”和“机器”。可这样的对抗升级，其实谁都不愿意看到。最后想问问大家，你们怎么看这种AI面试作弊现象？欢迎在评论区留言交流💬。\n最后还是提醒大家不要想通过走捷径的方式来达到目的，这在长远来讲肯定是不好的，如果面试很吃力的话，我有几个最近大厂做过的实习项目感兴趣可以看我简介中的项目地址，可以包装到简历中绝对对你的面试有帮助",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/6841907e000000002001fac6.txt@95b77bb261048059846273688e4b90a2e108b437",
