    {
      "source_unit_id": "xhs:6801f5fb000000001d02ead7:snapshot-95b77bb26104:note-desc-4:u2",
      "position": 2,
      "source_unit_type": "narrative-summary",
      "text_projection": "算法题：最长回文序列。就只剩leetcode刷的还行了，直接秒了。（话说为什么国内面试官都喜欢直接开写，不让我讲思路呢。好不容易到我能讲出来的环节了好想说话啊[叹气R]）习惯了上来先写了O(n^2)，写完想讲优化的时候意识到我是不是该直接写最优解。面试官让第二种讲思路就行就又讲了一下马拉车算法。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/6801f5fb000000001d02ead7.txt@95b77bb261048059846273688e4b90a2e108b437",
