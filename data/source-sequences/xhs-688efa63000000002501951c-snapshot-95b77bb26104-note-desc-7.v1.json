  "units": [
    {
      "source_unit_id": "xhs:688efa63000000002501951c:snapshot-95b77bb26104:note-desc-7:u1",
      "position": 1,
      "source_unit_type": "outcome-reflection-summary",
      "text_projection": "刚刚结束了阿里巴巴嵌入式软件开发的电话一面，虽然最终挂了\n，但收获满满！赶紧整理出这份25分钟的面试全攻略，希望能帮\n到同样在求职路上的小伙伴们。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/688efa63000000002501951c.txt@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "5f0069a1884bdd73e0e831c21082a50d31851b13f2aab1ae98027c2f2a00ec5e",
        "raw_artifact_ref": "liqiangcc/xhs:note_detail/688efa63000000002501951c.html@95b77bb261048059846273688e4b90a2e108b437",
        "raw_sha256": "cfea00135aaf82b5cf485a484229cfd571dac82e5bcd4e76742cae5726d2265a",
        "source_projection_item_number": 1
      },
      "fragments": []
    },
    {
      "source_unit_id": "xhs:688efa63000000002501951c:snapshot-95b77bb26104:note-desc-7:u2",
      "position": 2,
      "source_unit_type": "question-like",
      "text_projection": "🔍 面试特点超级明显\n这次面试完全是纯问答形式，没有手撕代码环节，但考察范围真\n的很广！从项目经验到基础理论，从网络协议到并发编程，几乎\n涵盖了嵌入式开发的方方面面。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/688efa63000000002501951c.txt@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "5f0069a1884bdd73e0e831c21082a50d31851b13f2aab1ae98027c2f2a00ec5e",
        "raw_artifact_ref": "liqiangcc/xhs:note_detail/688efa63000000002501951c.html@95b77bb261048059846273688e4b90a2e108b437",
        "raw_sha256": "cfea00135aaf82b5cf485a484229cfd571dac82e5bcd4e76742cae5726d2265a",
        "source_projection_item_number": 2
      },
      "fragments": []
    },
    {
      "source_unit_id": "xhs:688efa63000000002501951c:snapshot-95b77bb26104:note-desc-7:u3",
      "position": 3,
      "source_unit_type": "question-like",
      "text_projection": "💡 核心考点分享\n面试官特别关注TCP三次握手的原理、C++内存布局、多线程安全\n机制等基础知识。还有一个很有意思的场景题：如何设计算法减\n少用户密码输入错误？这种题目真的很考验实际解决问题的能力\n。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/688efa63000000002501951c.txt@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "5f0069a1884bdd73e0e831c21082a50d31851b13f2aab1ae98027c2f2a00ec5e",
        "raw_artifact_ref": "liqiangcc/xhs:note_detail/688efa63000000002501951c.html@95b77bb261048059846273688e4b90a2e108b437",
        "raw_sha256": "cfea00135aaf82b5cf485a484229cfd571dac82e5bcd4e76742cae5726d2265a",
        "source_projection_item_number": 3
      },
      "fragments": []
    },
    {
      "source_unit_id": "xhs:688efa63000000002501951c:snapshot-95b77bb26104:note-desc-7:u4",
      "position": 4,
      "source_unit_type": "question-like",
      "text_projection": "🛠️ 工程实践很重要\n大型项目中如何快速定位某个class？面试官问得很细，grep、c\nscope、IDE索引等工具的使用都要熟练掌握。头文件重复包含的\n防护方法也是必考点。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/688efa63000000002501951c.txt@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "5f0069a1884bdd73e0e831c21082a50d31851b13f2aab1ae98027c2f2a00ec5e",
        "raw_artifact_ref": "liqiangcc/xhs:note_detail/688efa63000000002501951c.html@95b77bb261048059846273688e4b90a2e108b437",
        "raw_sha256": "cfea00135aaf82b5cf485a484229cfd571dac82e5bcd4e76742cae5726d2265a",
        "source_projection_item_number": 4
      },
      "fragments": []
    },
    {
      "source_unit_id": "xhs:688efa63000000002501951c:snapshot-95b77bb26104:note-desc-7:u5",
      "position": 5,
      "source_unit_type": "narrative-summary",
      "text_projection": "⚡ 时间真的很紧张\n25分钟要覆盖这么多内容，节奏把控很关键。项目介绍要简洁有\n力，技术点回答要准确到位，不能拖泥带水。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/688efa63000000002501951c.txt@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "5f0069a1884bdd73e0e831c21082a50d31851b13f2aab1ae98027c2f2a00ec5e",
        "raw_artifact_ref": "liqiangcc/xhs:note_detail/688efa63000000002501951c.html@95b77bb261048059846273688e4b90a2e108b437",
        "raw_sha256": "cfea00135aaf82b5cf485a484229cfd571dac82e5bcd4e76742cae5726d2265a",
        "source_projection_item_number": 5
      },
      "fragments": []
    },
    {
      "source_unit_id": "xhs:688efa63000000002501951c:snapshot-95b77bb26104:note-desc-7:u6",
      "position": 6,
      "source_unit_type": "outcome-reflection-summary",
      "text_projection": "📚 备考建议总结\n重点还是要把基础打牢，特别是C/C++语言特性、网络协议、操\n作系统这些核心概念。项目经验也要好好梳理，能够深入阐述技\n术选型和实现细节。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/688efa63000000002501951c.txt@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "5f0069a1884bdd73e0e831c21082a50d31851b13f2aab1ae98027c2f2a00ec5e",
        "raw_artifact_ref": "liqiangcc/xhs:note_detail/688efa63000000002501951c.html@95b77bb261048059846273688e4b90a2e108b437",
        "raw_sha256": "cfea00135aaf82b5cf485a484229cfd571dac82e5bcd4e76742cae5726d2265a",
        "source_projection_item_number": 6
      },
      "fragments": []
    },
    {
      "source_unit_id": "xhs:688efa63000000002501951c:snapshot-95b77bb26104:note-desc-7:u7",
      "position": 7,
      "source_unit_type": "outcome-reflection-summary",
      "text_projection": "虽然这次没通过，但学到了很多！阿里的技术要求确实很高，继\n续努力💪",
