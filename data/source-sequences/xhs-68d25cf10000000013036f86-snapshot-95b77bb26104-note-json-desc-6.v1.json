      "text_projection": "💻面试岗位：后端开发工程师",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_json/68d25cf10000000013036f86.json@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "67ca4c46d9615084dfe8dcb9d9d6a072966552571e6ca701cc98a436c23b4d96",
        "raw_artifact_ref": "liqiangcc/xhs:note_detail/68d25cf10000000013036f86.html@95b77bb261048059846273688e4b90a2e108b437",
        "raw_sha256": "a070075bae48f782d126db2039a010f5ee6c4ea2e125e99c240bb515bcc1fd75",
