    {
      "source_unit_id": "xhs:68ad29ea000000001c01160c:snapshot-95b77bb26104:note-desc-5:u1",
      "position": 1,
      "source_unit_type": "question-like",
      "text_projection": "整体感受：\n百度是纯简历面，简历从上到下挨个问的，除了有一个可能和深度学习关系不大没问，其余都问了[举手R]。所以写在简历上的内容，大家也一定要熟记于心，做到对答如流。这是唯一一个自己可控的事情[微笑R]。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/68ad29ea000000001c01160c.txt@95b77bb261048059846273688e4b90a2e108b437",
