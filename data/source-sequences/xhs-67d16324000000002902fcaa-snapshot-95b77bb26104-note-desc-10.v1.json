    {
      "source_unit_id": "xhs:67d16324000000002902fcaa:snapshot-95b77bb26104:note-desc-10:u7",
      "position": 7,
      "source_unit_type": "outcome-reflection-summary",
      "text_projection": "⭕总结：和一面形成鲜明对比。首先面试官会频繁打断你，不接受你的任何引导，会执意提问很深很偏的东西直到你承认自己答不上来为止。全程眉头都紧皱，全程无反馈，只有一个问题接着下一个问题。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/67d16324000000002902fcaa.txt@95b77bb261048059846273688e4b90a2e108b437",
