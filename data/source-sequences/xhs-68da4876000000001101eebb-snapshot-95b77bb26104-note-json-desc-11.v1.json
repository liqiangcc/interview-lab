    {
      "source_unit_id": "xhs:68da4876000000001101eebb:snapshot-95b77bb26104:note-json-desc-11:u11",
      "position": 11,
      "source_unit_type": "narrative-summary",
      "text_projection": "如果反转后整数超过 32 位的有符号整数的范围 [−2^31,  2^31 − 1] ，就返回 0。\n假设环境不允许存储 64 位整数（有符号或无符号）。示例 1：输入：x = 123输出：321示例 2：输入：x = -123输出：-321示例 3：输入：x = 120输出：21",
      "source_provenance": {
