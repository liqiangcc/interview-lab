  "units": [
    {
      "source_unit_id": "xhs:6777bcc20000000014025251:snapshot-95b77bb26104:note-desc-5:u1",
      "position": 1,
      "source_unit_type": "outcome-reflection-summary",
      "text_projection": "百度 凤巢业务 一面 12.12 （通过）\n自我介绍 1 min\n项目介绍 10 min\n项目中提到的大促备战里有 慢SQL优化和 慢接口优化 都是怎么做的\n项目中我参与的重构部分以及重构思路\n我独立负责的开发的模块，以及我对这些模块中每一版的优化思路\nSpringBoot的启动原理？自动装配的实现机制\n有了Spring为什么还要有SpringBoot\n线程池的实现机理？几种线程池的对比？\nRedis的几种部署方案？我们项目中的用法\n集群模式下的衍生的渐进式哈希和一致性哈希？",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/6777bcc20000000014025251.txt@95b77bb261048059846273688e4b90a2e108b437",
