      "fragments": []
    },
    {
      "source_unit_id": "xhs:67fbcdd7000000001c036797:snapshot-95b77bb26104:note-desc-13:u4",
      "position": 4,
      "source_unit_type": "outcome-reflection-summary",
      "text_projection": "继续问java，讲shiro反序列化漏洞的原理（当时记不清了，所以我讲了下一般java反序列原理），接着问有没有单独调试过java反序列化的过程，我回答没有，想引导面试官问我php和python，结果他问了我golang和java反序列化的区别是什么？java反序列化漏洞出现的本质原因是什么？",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/67fbcdd7000000001c036797.txt@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "f93539ef875eebbd3cfa2844141db355a2c75c010b3509d03e462f81de65b054",
