    {
      "source_unit_id": "xhs:67fbcdd7000000001c036797:snapshot-95b77bb26104:note-desc-13:u3",
      "position": 3,
      "source_unit_type": "narrative-summary",
      "text_projection": "介绍一道ctf遇到的比较难的java题目，我当时很离谱地想到了网鼎杯里面的一道0解题（赛后也没有wp），所以回答的很混乱，只说是一个JNDI注入。我确实不太会java，面试官说80%的业务都是java相关的。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/67fbcdd7000000001c036797.txt@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "f93539ef875eebbd3cfa2844141db355a2c75c010b3509d03e462f81de65b054",
        "raw_artifact_ref": "liqiangcc/xhs:note_detail/67fbcdd7000000001c036797.html@95b77bb261048059846273688e4b90a2e108b437",
        "raw_sha256": "7b28bd08b7e1a137433741b0d04ec6b98f2134a12c10b0eec49fb3225bfa29f8",
        "source_projection_item_number": 3
