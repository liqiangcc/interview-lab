      },
      "fragments": []
    },
    {
      "source_unit_id": "xhs:67fbcdd7000000001c036797:snapshot-95b77bb26104:note-desc-13:u5",
      "position": 5,
      "source_unit_type": "question-like",
      "text_projection": "因为上一个问题中又提到了JNDI，于是问JNDI的payload长啥样，我真忘了，就简单描述了一下利用过程。面试官继续深入问了下这个流程存在的问题，还有为什么log4j2这样一个日志模块会和JNDI扯上联系，这个我确实没考虑过，只能说确实不了解。",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/67fbcdd7000000001c036797.txt@95b77bb261048059846273688e4b90a2e108b437",
        "source_projection_sha256": "f93539ef875eebbd3cfa2844141db355a2c75c010b3509d03e462f81de65b054",
