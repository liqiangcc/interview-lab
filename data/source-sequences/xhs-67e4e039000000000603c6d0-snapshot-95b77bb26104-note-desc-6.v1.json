      "source_unit_type": "question-like",
      "text_projection": "1、项目",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_desc/67e4e039000000000603c6d0.txt@95b77bb261048059846273688e4b90a2e108b437",
