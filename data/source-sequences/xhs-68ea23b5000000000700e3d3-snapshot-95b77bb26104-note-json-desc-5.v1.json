      "position": 3,
      "source_unit_type": "narrative-summary",
      "text_projection": "后面就让讲一下自己印象最深的项目\n我就讲了实验室乙方项目，一把辛酸一把泪",
      "source_provenance": {
        "source_projection_ref": "liqiangcc/xhs:note_json/68ea23b5000000000700e3d3.json@95b77bb261048059846273688e4b90a2e108b437",
