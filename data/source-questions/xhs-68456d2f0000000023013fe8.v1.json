      "source_unit_id": "xhs:68456d2f0000000023013fe8:snapshot-95b77bb26104:note-desc-15:u3",
      "unit_position": 3,
      "raw_text": "尤其对于社招来说，面试官更关注你的项目经历、在团队中的定位与技术深度。一个清晰、有重点的自我介绍，不仅能降低面试官的理解成本，还能引导对方问你擅长的内容，为接下来的技术深聊做好铺垫。",
      "extraction_status": "extracted"
