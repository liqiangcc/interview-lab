      "source_question_id": "xhs:68cb6f5d000000000e0320ca:snapshot-95b77bb26104:note-desc-26:u11:sq1",
      "source_unit_id": "xhs:68cb6f5d000000000e0320ca:snapshot-95b77bb26104:note-desc-26:u11",
      "unit_position": 11,
      "raw_text": "10. 你觉得Hashmap线程不安全，那你能举一个例子说，比如说我多线程对它操作，它会出现什么情况？有什么样？它的线程不安全体现在哪里？",
      "extraction_status": "extracted"
