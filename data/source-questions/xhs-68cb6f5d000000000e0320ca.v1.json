      "source_question_id": "xhs:68cb6f5d000000000e0320ca:snapshot-95b77bb26104:note-desc-26:u10:sq1",
      "source_unit_id": "xhs:68cb6f5d000000000e0320ca:snapshot-95b77bb26104:note-desc-26:u10",
      "unit_position": 10,
      "raw_text": "9. 那你了解 concurrentHashmap，它跟哈希表有什么区别吗？",
      "extraction_status": "extracted"
