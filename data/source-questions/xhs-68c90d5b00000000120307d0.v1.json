      "source_unit_id": "xhs:68c90d5b00000000120307d0:snapshot-95b77bb26104:note-desc-24:u7",
      "unit_position": 7,
      "raw_text": "7. 支持双机房是吧，那你们AB是active-active吗？还是有优先？有做流量切换的能力吧",
      "extraction_status": "extracted"
    },
