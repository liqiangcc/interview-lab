{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liqiangcc/interview-lab/schemas/issue-1539-recovery-plan.schema.json",
  "title": "Issue #1539 recovery plan manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "source_snapshot", "source_review", "boundary_expansion"],
  "properties": {
    "schema_version": {"const": "issue-1539-recovery-plan.v1"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "source_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "items"],
      "properties": {
        "batch_id": {"type": "string", "minLength": 1},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["interview_issue_number", "source_note_issue_number"],
            "properties": {
              "interview_issue_number": {"type": "integer", "minimum": 1},
              "source_note_issue_number": {"type": "integer", "minimum": 1},
              "interview_note_id": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "boundary_expansion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "selection_policy", "issue_numbers"],
      "properties": {
        "batch_id": {"type": "string", "minLength": 1},
        "selection_policy": {"const": "pending-source-note-issue-number-ascending"},
        "issue_numbers": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
