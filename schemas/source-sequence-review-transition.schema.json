{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liqiangcc/interview-lab/schemas/source-sequence-review-transition.schema.json",
  "title": "SourceSequenceReview transition request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "manifest_id",
    "manifest_sha256",
    "expected_effective_review_id",
    "new_review_id",
    "decision",
    "reviewed_at",
    "reviewer_kind",
    "review_evidence",
    "checks",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "source-sequence-review-transition.v1"},
    "transition_id": {"type": "string", "minLength": 1},
    "manifest_id": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_effective_review_id": {"type": ["string", "null"]},
    "new_review_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["approved", "rejected"]},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "reviewer_kind": {"enum": ["human", "ai-assisted"]},
    "review_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "issue_number", "comment_id"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "issue_number": {"type": "integer", "minimum": 1},
        "comment_id": {"type": "integer", "minimum": 1}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "result"],
        "properties": {
          "check_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "result": {"enum": ["pass", "fail"]},
          "note": {"type": "string"}
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
