{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liqiangcc/interview-lab/schemas/interview-note-source-review-transition.schema.json",
  "title": "InterviewNote Source Review transition request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "repository",
    "issue_number",
    "interview_note_id",
    "expected_interview_body_sha256",
    "expected_initial_status",
    "expected_source_revision_id",
    "source_note_issue_number",
    "expected_source_note_body_sha256",
    "decision",
    "reviewed_at",
    "reviewer_kind",
    "review_evidence",
    "checks",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "interview-note-source-review-transition.v1"},
    "transition_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "issue_number": {"type": "integer", "minimum": 1},
    "interview_note_id": {"type": "string", "minLength": 1},
    "expected_interview_body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_initial_status": {"enum": ["captured", "blocked", "source-ready"]},
    "expected_source_revision_id": {"type": "string", "minLength": 1},
    "source_note_issue_number": {"type": "integer", "minimum": 1},
    "expected_source_note_body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_source_repository_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "decision": {"enum": ["source-ready", "blocked"]},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "reviewer_kind": {"enum": ["human", "ai-assisted"]},
    "review_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "issue_number", "comment_id"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "issue_number": {"type": "integer", "minimum": 1},
        "comment_id": {"type": "integer", "minimum": 1}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "result"],
        "properties": {
          "check_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "result": {"enum": ["pass", "fail"]},
          "note": {"type": "string"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "case_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "provenance_mode": {"enum": ["raw-lineage", "pinned-source-artifact"]},
    "provenance_statement": {"type": "string", "minLength": 1},
    "pinned_artifact_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recovery_mode": {"enum": ["blocked-source-recovery", "source-ready-receipt-repair"]}
  },
  "allOf": [
    {
      "anyOf": [
        {"required": ["expected_manifest_sha256"]},
        {"required": ["expected_source_repository_ref"]}
      ]
    },
    {
      "if": {"required": ["provenance_mode"], "properties": {"provenance_mode": {"const": "pinned-source-artifact"}}},
      "then": {
        "required": ["provenance_statement", "pinned_artifact_manifest_sha256"],
        "properties": {"provenance_statement": {"const": "pinned-source-artifact; raw-lineage-unproven"}}
      }
    },
    {
      "if": {"required": ["provenance_statement"]},
      "then": {
        "required": ["provenance_mode"],
        "properties": {"provenance_mode": {"const": "pinned-source-artifact"}}
      }
    },
    {
      "if": {"required": ["recovery_mode"], "properties": {"recovery_mode": {"const": "blocked-source-recovery"}}},
      "then": {
        "required": ["recovery_mode", "provenance_mode", "provenance_statement", "pinned_artifact_manifest_sha256", "evidence_subject_sha256"],
        "properties": {
          "expected_initial_status": {"const": "blocked"},
          "decision": {"const": "source-ready"},
          "provenance_mode": {"const": "pinned-source-artifact"},
          "provenance_statement": {"const": "pinned-source-artifact; raw-lineage-unproven"}
        }
      }
    },
    {
      "if": {"required": ["recovery_mode"], "properties": {"recovery_mode": {"const": "source-ready-receipt-repair"}}},
      "then": {
        "required": ["recovery_mode", "evidence_subject_sha256"],
        "properties": {
          "expected_initial_status": {"const": "source-ready"},
          "decision": {"const": "source-ready"}
        }
      }
    },
    {
      "if": {"not": {"required": ["recovery_mode"]}},
      "then": {"properties": {"expected_initial_status": {"const": "captured"}}}
    }
  ]
}
