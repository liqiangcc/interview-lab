{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liqiangcc/interview-lab/schemas/source-note-boundary-review-transition.schema.json",
  "title": "SourceNote Boundary Review transition request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "repository",
    "issue_number",
    "source_note_id",
    "expected_body_sha256",
    "expected_boundary_status",
    "expected_source_revision_id",
    "expected_manifest_sha256",
    "expected_source_repository_ref",
    "decision",
    "reviewed_at",
    "reviewer_kind",
    "review_evidence",
    "checks",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "source-note-boundary-review-transition.v1"},
    "transition_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "issue_number": {"type": "integer", "minimum": 1},
    "source_note_id": {"type": "string", "pattern": "^xhs-note:.+$"},
    "expected_body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_boundary_status": {"const": "pending"},
    "expected_source_revision_id": {"type": "string", "minLength": 1},
    "expected_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "expected_source_repository_ref": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "decision": {"enum": ["not-interview", "single-interview", "multi-interview"]},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "reviewer_kind": {"enum": ["human", "ai-assisted"]},
    "review_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "issue_number", "comment_id"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "issue_number": {"type": "integer", "minimum": 1},
        "comment_id": {"type": "integer", "minimum": 1}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "result"],
        "properties": {
          "check_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "result": {"enum": ["pass", "fail"]},
          "note": {"type": "string"}
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
