{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liqiangcc/interview-lab/schemas/source-sequence-manifest.schema.json",
  "title": "SourceSequenceManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "content_sha256",
    "interview_note_id",
    "source_revision_id",
    "sequence_scope",
    "evidence_stream",
    "units"
  ],
  "properties": {
    "schema_version": {"const": "source-sequence-manifest.v1"},
    "manifest_id": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "interview_note_id": {"type": "string", "minLength": 1},
    "source_revision_id": {"type": "string", "minLength": 1},
    "sequence_scope": {"type": "string", "minLength": 1},
    "evidence_stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream_id", "raw_artifact_ref", "raw_git_blob_sha", "raw_sha256"],
      "properties": {
        "stream_id": {"type": "string", "minLength": 1},
        "raw_artifact_ref": {"type": "string", "minLength": 1},
        "storage_kind": {"enum": ["git", "runtime-artifact-store"]},
        "raw_git_blob_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "readable_projection": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["ref", "git_blob_sha", "provenance", "review_status"],
          "properties": {
            "ref": {"type": "string", "minLength": 1},
            "storage_kind": {"enum": ["git", "runtime-artifact-store"]},
            "git_blob_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "provenance": {"enum": ["derived", "source_projection"]},
            "review_status": {"enum": ["unreviewed", "fidelity-reviewed"]}
          }
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_unit_id", "position", "source_unit_type", "text_projection", "fragments"],
          "properties": {
            "source_unit_id": {"type": "string", "minLength": 1},
            "position": {"type": "integer", "minimum": 1},
            "source_unit_type": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
            "text_projection": {"type": "string", "minLength": 1},
            "source_provenance": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["source_projection_ref", "source_projection_sha256", "raw_artifact_ref", "raw_sha256", "source_projection_item_number"],
              "properties": {
                "source_projection_ref": {"type": "string", "minLength": 1},
                "source_projection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "raw_artifact_ref": {"type": "string", "minLength": 1},
                "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "source_projection_item_number": {"type": "integer", "minimum": 1}
              }
            },
            "fragments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_fragment_id", "order", "fragment_type", "text_projection"],
              "properties": {
                "source_fragment_id": {"type": "string", "minLength": 1},
                "order": {"type": "integer", "minimum": 1},
                "fragment_type": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
                "text_projection": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
