{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liqiangcc/interview-lab/schemas/issue-1657-blocker-repair-plan.schema.json",
  "title": "Issue #1657 fail-closed blocker repair evidence and decision plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "parent_issue", "mode", "source_snapshot_digest", "ownership_inventory_digest", "materialization_plan_digest", "boundary_report_digest", "boundary_transition_report_digest", "owner_receipt_snapshot_digest", "live_reaudit_snapshot_digest", "target_count", "blocked_count", "mutation_performed", "write_operations", "results", "errors", "ok", "plan_digest"],
  "properties": {
    "schema_version": {"const": "issue-1657-blocker-repair-plan.v2"},
    "repository": {"const": "liqiangcc/interview-lab"},
    "parent_issue": {"const": 1657},
    "mode": {"const": "read-only-audit-plan"},
    "source_snapshot_digest": {"type": ["string", "null"]},
    "ownership_inventory_digest": {"type": ["string", "null"]},
    "materialization_plan_digest": {"type": ["string", "null"]},
    "boundary_report_digest": {"type": ["string", "null"]},
    "boundary_transition_report_digest": {"type": ["string", "null"]},
    "owner_receipt_snapshot_digest": {"type": ["string", "null"]},
    "live_reaudit_snapshot_digest": {"type": ["string", "null"]},
    "target_count": {"const": 3},
    "blocked_count": {"type": "integer", "minimum": 0, "maximum": 3},
    "mutation_performed": {"const": false},
    "write_operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patch", "post", "label", "interview_note", "create"],
      "properties": {"patch": {"const": 0}, "post": {"const": 0}, "label": {"const": 0}, "interview_note": {"const": 0}, "create": {"const": 0}}
    },
    "results": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/result"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "ok": {"const": false},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "result": {
      "type": "object",
      "required": ["source_note_issue_number", "source_note_id", "interview_note_id", "owner_issue_number", "source_note_body_sha256", "source_revision_id", "source_repository_ref", "action", "decision_class", "reason_codes", "errors", "request", "live_audit", "mutation_performed", "write_operations"],
      "properties": {
        "source_note_issue_number": {"type": "integer", "enum": [904, 907, 910]},
        "source_note_id": {"type": ["string", "null"]},
        "interview_note_id": {"type": "string", "minLength": 1},
        "owner_issue_number": {"type": "integer", "enum": [2, 4, 915]},
        "source_note_body_sha256": {"type": ["string", "null"]},
        "source_revision_id": {"type": ["string", "null"]},
        "source_repository_ref": {"type": ["string", "null"]},
        "action": {"type": "string", "pattern": "^blocked-"},
        "decision_class": {"enum": ["repairable-after-independent-owner-review-and-CAS", "must-manually-confirm-boundary-evidence-and-runtime-provenance"]},
        "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "errors": {"type": "array", "items": {"type": "string"}},
        "request": {"type": "object"},
        "live_audit": {"type": "object"},
        "mutation_performed": {"const": false},
        "write_operations": {"$ref": "#/properties/write_operations"}
      }
    }
  }
}
