{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liqiangcc/interview-lab/schemas/issue-1607-boundary-evidence.schema.json",
  "title": "Issue 1607 Boundary B evidence",
  "type": "object",
  "required": ["schema_version", "transition_id", "repository", "child_issue", "issue_number", "source_note_id", "expected_body_sha256", "expected_source_revision_id", "expected_source_repository_ref", "evidence_status", "decision", "classification", "source_evidence", "checks", "limitations"],
  "properties": {
    "schema_version": { "const": "issue-1607-boundary-evidence.v1" },
    "repository": { "const": "liqiangcc/interview-lab" },
    "child_issue": { "const": 1607 },
    "issue_number": { "type": "integer", "minimum": 393, "maximum": 765 },
    "evidence_status": { "enum": ["blocked", "review-required"] },
    "decision": { "const": "pending" },
    "classification": { "type": "object", "required": ["status", "proposed_decision", "basis"] },
    "source_evidence": { "type": "object", "required": ["ref", "kind", "provenance", "git_blob_sha", "byte_size", "sha256", "locator", "excerpt", "text", "line_count", "verification"], "properties": { "byte_size": { "type": ["integer", "null"] }, "sha256": { "type": ["string", "null"] } } },
    "checks": { "type": "array", "minItems": 6 },
    "limitations": { "type": "array", "minItems": 3 }
  }
}
