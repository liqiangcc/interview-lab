{
  "schema_version": "issue-label-taxonomy.v4",
  "dimensions": {
    "type": [
      "type:interview-note",
      "type:canonical-question"
    ],
    "source": [
      "source:xhs",
      "source:nowcoder",
      "source:maimai",
      "source:manual",
      "source:other"
    ],
    "status": [
      "status:discovered",
      "status:captured",
      "status:source-review",
      "status:source-ready",
      "status:blocked"
    ],
    "quality": [
      "quality:source-incomplete",
      "quality:image-missing",
      "quality:text-truncated",
      "quality:artifact-corrupt",
      "quality:identity-conflict",
      "quality:duplicate-source",
      "quality:provenance-missing"
    ],
    "task": [
      "task:source-recovery",
      "task:source-review",
      "task:artifact-check",
      "task:identity-review",
      "task:question-extraction",
      "task:question-review"
    ],
    "priority": [
      "priority:P0",
      "priority:P1",
      "priority:P2"
    ],
    "migration": [
      "migration:xhs-bulk"
    ],
    "role": [
      "role:backend",
      "role:frontend",
      "role:client",
      "role:algorithm",
      "role:data",
      "role:qa",
      "role:product",
      "role:other"
    ],
    "recruitment": [
      "recruitment:campus",
      "recruitment:social",
      "recruitment:internship"
    ],
    "round": [
      "round:1",
      "round:2",
      "round:3",
      "round:4",
      "round:5",
      "round:6",
      "round:7",
      "round:8",
      "round:9",
      "round:hr",
      "round:final"
    ]
  },
  "dynamic_dimensions": {
    "company": {
      "prefix": "company:",
      "value_pattern": "^[a-z0-9][a-z0-9-]*$",
      "source": "reviewed InterviewContext.company.id"
    },
    "source-year": {
      "prefix": "source-year:",
      "value_pattern": "^\\d{4}$",
      "source": "InterviewNote.source_published_at"
    },
    "interview-year": {
      "prefix": "interview-year:",
      "value_pattern": "^\\d{4}$",
      "source": "reviewed InterviewContext.interview_occurred_at"
    }
  },
  "constraints": {
    "interview_note": {
      "required": ["type:interview-note"],
      "at_most_one_from": ["status", "company", "role", "recruitment", "round", "source-year", "interview-year"],
      "learning_discovery_requires_status": "status:source-ready",
      "forbid_prefixes_for_facts": [
        "year:",
        "note:",
        "tech:",
        "canonical:",
        "result:",
        "outcome:"
      ]
    }
  },
  "notes": [
    "Workflow Label 与 Learning Discovery Label 都只是 projection，不是领域事实证明。",
    "migration:xhs-bulk 是临时 operational label，仅表示该 Issue 来自通过 batch preflight 的 XHS 全量 intake；它不是 Source/Knowledge 事实。",
    "bulk intake Issue 进入 Source review 前必须先移除 migration:xhs-bulk；unlabeled 事件恢复普通 live validator。",
    "Learning Discovery Label 必须来自 reviewed InterviewContext 或明确指定的权威 Source field。",
    "只有 status:source-ready 的 InterviewNote 才允许进入 Learning Discovery Label 学习池；source-review / blocked case 保持在 Source 工作流。",
    "Company 是一级学习入口，允许使用 normalized company id 动态创建受控标签。",
    "Role 只使用粗粒度 family；精确岗位 title 保留在 InterviewContext。",
    "source-year:YYYY 统一从 InterviewNote.source_published_at 投影；不经过 AI 推断。",
    "interview-year:YYYY 只在 reviewed InterviewContext.interview_occurred_at 能证明年份时投影。",
    "source-year 与 interview-year 语义独立，允许不同；禁止使用含义模糊的 year:YYYY。",
    "Unknown / month_day 不生成对应年份 Label。",
    "结果与 Outcome 默认不进入普通学习 Issue 标签，避免学习前剧透。",
    "新增 Label family 必须通过显式 taxonomy revision。"
  ]
}
