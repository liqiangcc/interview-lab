{
  "schema_version": "issue-label-taxonomy.v1",
  "dimensions": {
    "type": [
      "type:interview-note",
      "type:canonical-question"
    ],
    "source": [
      "source:xhs",
      "source:nowcoder",
      "source:maimai",
      "source:manual",
      "source:other"
    ],
    "status": [
      "status:discovered",
      "status:captured",
      "status:source-review",
      "status:source-ready",
      "status:blocked"
    ],
    "quality": [
      "quality:source-incomplete",
      "quality:image-missing",
      "quality:text-truncated",
      "quality:artifact-corrupt",
      "quality:identity-conflict",
      "quality:duplicate-source",
      "quality:provenance-missing"
    ],
    "task": [
      "task:source-recovery",
      "task:source-review",
      "task:artifact-check",
      "task:identity-review",
      "task:question-extraction",
      "task:question-review"
    ],
    "priority": [
      "priority:P0",
      "priority:P1",
      "priority:P2"
    ]
  },
  "constraints": {
    "interview_note": {
      "required": ["type:interview-note"],
      "at_most_one_from": ["status"],
      "forbid_prefixes_for_facts": [
        "company:",
        "role:",
        "year:",
        "note:",
        "tech:"
      ]
    }
  },
  "notes": [
    "Label 只用于工作流和查询投影，不是领域事实的证明。",
    "公司、岗位、年份、技术等高基数事实进入结构化 Issue 内容，不进入全局 Label。",
    "新增 Label 必须通过显式 taxonomy revision。"
  ]
}
