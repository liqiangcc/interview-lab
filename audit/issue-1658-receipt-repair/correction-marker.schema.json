{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liqiangcc/interview-lab/blob/main/audit/issue-1658-receipt-repair/correction-marker.schema.json",
  "title": "Historical applied boundary receipt correction marker",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "correction_id",
    "reason",
    "repository",
    "source_note_issue_number",
    "source_note_id",
    "source_note_body_sha256",
    "source_revision_id",
    "source_repository_ref",
    "transition_id",
    "original_receipt",
    "corrected_receipt",
    "owner_binding",
    "materialization_binding",
    "evidence_binding"
  ],
  "properties": {
    "schema_version": { "const": "source-note-boundary-review-applied-correction.v1" },
    "correction_id": { "type": "string", "pattern": "^issue-1658-receipt-repair-(1309|1325|1333|1363|1375|1376|1380|1401|1406|1418|1428|1447|1458)-v1$" },
    "reason": { "const": "historical-empty-interview-note-ids-reconciled" },
    "repository": { "const": "liqiangcc/interview-lab" },
    "source_note_issue_number": { "type": "integer", "minimum": 1 },
    "source_note_id": { "type": "string", "pattern": "^xhs-note:.+$" },
    "source_note_body_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_revision_id": { "type": "string", "minLength": 1 },
    "source_repository_ref": { "const": "95b77bb261048059846273688e4b90a2e108b437" },
    "transition_id": { "type": "string", "minLength": 1 },
    "original_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comment_id", "issue_url", "schema_version", "body_sha256", "marker_sha256", "interview_note_ids"],
      "properties": {
        "comment_id": { "type": "integer", "minimum": 1 },
        "issue_url": { "type": "string", "pattern": "^https://api\\.github\\.com/repos/liqiangcc/interview-lab/issues/[0-9]+$" },
        "schema_version": { "const": "source-note-boundary-review-applied.v1" },
        "body_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "marker_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "interview_note_ids": { "const": [] }
      }
    },
    "corrected_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interview_note_ids", "interview_note_cases"],
      "properties": {
        "interview_note_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^xhs:.+$" } },
        "interview_note_cases": { "const": null }
      }
    },
    "owner_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_number", "interview_note_id", "body_sha256", "labels"],
      "properties": {
        "issue_number": { "type": "integer", "minimum": 1 },
        "interview_note_id": { "type": "string", "pattern": "^xhs:.+$" },
        "body_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "labels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "materialization_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comment_id", "issue_url", "body_sha256", "marker_sha256", "source_note_id", "source_note_body_sha256", "source_revision_id", "source_repository_ref", "interview_note_id", "interview_issue_number", "interview_issue_body_sha256"],
      "properties": {
        "comment_id": { "type": "integer", "minimum": 1 },
        "issue_url": { "type": "string", "pattern": "^https://api\\.github\\.com/repos/liqiangcc/interview-lab/issues/[0-9]+$" },
        "body_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "marker_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_note_id": { "type": "string", "pattern": "^xhs-note:.+$" },
        "source_note_body_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_revision_id": { "type": "string", "minLength": 1 },
        "source_repository_ref": { "const": "95b77bb261048059846273688e4b90a2e108b437" },
        "interview_note_id": { "type": "string", "pattern": "^xhs:.+$" },
        "interview_issue_number": { "type": "integer", "minimum": 1 },
        "interview_issue_body_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comment_id", "issue_url", "body_sha256", "marker_sha256", "schema_version", "transition_id"],
      "properties": {
        "comment_id": { "type": "integer", "minimum": 1 },
        "issue_url": { "type": "string", "pattern": "^https://api\\.github\\.com/repos/liqiangcc/interview-lab/issues/[0-9]+$" },
        "body_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "marker_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "schema_version": { "const": "issue-1608-boundary-evidence.v1" },
        "transition_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
